# Copy to .env (git-ignored) and change every value.

# Docker Compose: password for the warehouse database user "bi"
POSTGRES_PASSWORD=change-me

# Dashboard HTTP Basic auth. Required whenever the dashboard listens on a non-loopback address.
BI_DASHBOARD_USER=admin
BI_DASHBOARD_PASSWORD=change-me-too

# Local runs: point at any PostgreSQL instance. If unset, an embedded PostgreSQL is started in ./.pgdata
# DATABASE_URL=postgresql+psycopg://bi:<password>@localhost:5432/bi
